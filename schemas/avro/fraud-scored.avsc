{
  "namespace": "com.fraudplatform.events.scoring",
  "type": "record",
  "name": "FraudScored",
  "doc": "Emitted by the Scoring Engine after a transaction has been evaluated against all fraud detection models. Contains composite risk scores from rule-based, ML, graph-analytics, and historical-behavior engines. This event drives downstream decisioning (auto-approve, auto-decline, or manual review queue routing) and feeds into the real-time analytics dashboard.",
  "fields": [
    {
      "name": "transaction_id",
      "type": "string",
      "doc": "Reference to the originating transaction (foreign key to TransactionCreated.transaction_id). Used for score-to-transaction correlation in case management."
    },
    {
      "name": "account_id",
      "type": "string",
      "doc": "Account holder identifier. Denormalized from the transaction for efficient account-level score aggregation without additional lookups."
    },
    {
      "name": "final_score",
      "type": "double",
      "doc": "Weighted composite fraud risk score in the range [0.0, 1.0]. Computed as a weighted combination of rule_score, ml_score, graph_score, and historical_score. Thresholds: < 0.3 auto-approve, 0.3-0.7 review, > 0.7 auto-decline (configurable per-client)."
    },
    {
      "name": "rule_score",
      "type": "double",
      "doc": "Score contribution from the deterministic rule engine in the range [0.0, 1.0]. Based on velocity limits, blacklist matches, geo-fencing violations, amount thresholds, and business-specific rules."
    },
    {
      "name": "ml_score",
      "type": "double",
      "doc": "Score contribution from the real-time ML inference pipeline in the range [0.0, 1.0]. Generated by the ensemble model (XGBoost + neural network) serving via the ML Model Gateway."
    },
    {
      "name": "graph_score",
      "type": "double",
      "doc": "Score contribution from the graph analytics engine in the range [0.0, 1.0]. Evaluates entity relationships (account-device-merchant-IP) to detect fraud rings, collusion networks, and synthetic identity patterns."
    },
    {
      "name": "historical_score",
      "type": "double",
      "doc": "Score contribution from historical behavioral analysis in the range [0.0, 1.0]. Compares current transaction against the account holder's established spending patterns, time-of-day profiles, and merchant affinity."
    },
    {
      "name": "decision",
      "type": "string",
      "doc": "Automated decisioning outcome based on final_score thresholds and override rules. Valid values: 'approved' (transaction proceeds), 'declined' (transaction blocked, issuer notified), 'review' (routed to analyst queue for manual investigation)."
    },
    {
      "name": "triggered_rules",
      "type": {
        "type": "array",
        "items": "string"
      },
      "default": [],
      "doc": "List of rule identifiers that fired during evaluation (e.g. 'VELOCITY_24H_EXCEEDED', 'HIGH_RISK_MCC', 'BLACKLISTED_DEVICE'). Empty array if no rules triggered. Used for explainability and rule performance analytics."
    },
    {
      "name": "anomaly_flags",
      "type": {
        "type": "array",
        "items": "string"
      },
      "default": [],
      "doc": "List of ML-detected anomaly indicators (e.g. 'AMOUNT_OUTLIER', 'TIME_DEVIATION', 'NEW_MERCHANT_CLUSTER', 'BEHAVIORAL_SHIFT'). Provides interpretability for ML model predictions."
    },
    {
      "name": "graph_patterns",
      "type": {
        "type": "array",
        "items": "string"
      },
      "default": [],
      "doc": "List of graph-based fraud pattern identifiers detected (e.g. 'FRAUD_RING_CLUSTER_42', 'SHARED_DEVICE_NETWORK', 'SYNTHETIC_IDENTITY_LINK'). References pattern definitions in the Graph Analytics Service."
    },
    {
      "name": "scoring_time_ms",
      "type": "long",
      "doc": "Total wall-clock time in milliseconds to complete all scoring pipelines (rule + ML + graph + historical). SLA target is < 50ms at p99. Used for performance monitoring and SLA compliance reporting."
    },
    {
      "name": "scored_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Timestamp when scoring completed, in milliseconds since Unix epoch (UTC). Used for latency measurement (scored_at - transaction_time) and time-series score analytics."
    }
  ]
}
