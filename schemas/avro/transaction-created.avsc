{
  "namespace": "com.fraudplatform.events.transaction",
  "type": "record",
  "name": "TransactionCreated",
  "doc": "Emitted by the Transaction Ingestion Service when a new payment transaction is received from an acquirer, payment gateway, or banking channel. This event triggers downstream fraud scoring, velocity checks, and real-time analytics. Schema is designed for high-throughput ingestion (~1,150 TPS sustained) with minimal serialization overhead.",
  "fields": [
    {
      "name": "transaction_id",
      "type": "string",
      "doc": "Internal globally unique transaction identifier (UUIDv7). Primary key for transaction lookups across all services."
    },
    {
      "name": "external_id",
      "type": "string",
      "doc": "External reference ID from the originating payment system (e.g. acquirer reference number, PSP transaction ID). Used for reconciliation and dispute resolution."
    },
    {
      "name": "account_id",
      "type": "string",
      "doc": "Internal account identifier of the cardholder or account holder initiating the transaction. Foreign key to the Account Profile Service."
    },
    {
      "name": "amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 18,
        "scale": 4
      },
      "doc": "Transaction amount in the minor unit of the specified currency. Uses fixed-point decimal to avoid floating-point precision loss in financial calculations. Precision 18, scale 4 supports amounts up to 99,999,999,999,999.9999."
    },
    {
      "name": "currency",
      "type": "string",
      "doc": "ISO 4217 three-letter currency code (e.g. 'USD', 'EUR', 'GBP'). Used for multi-currency velocity aggregation and cross-border risk scoring."
    },
    {
      "name": "transaction_type",
      "type": "string",
      "doc": "Classification of the transaction type: 'purchase', 'withdrawal', 'transfer', 'refund', 'pre_auth', 'reversal', 'p2p'. Drives rule-engine branching logic."
    },
    {
      "name": "merchant_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Unique merchant identifier (acquirer-assigned MID). Null for non-POS transactions such as P2P transfers or ATM withdrawals."
    },
    {
      "name": "merchant_name",
      "type": ["null", "string"],
      "default": null,
      "doc": "Merchant descriptor name as provided by the acquirer. May be cleaned/normalized by the ingestion pipeline."
    },
    {
      "name": "merchant_category",
      "type": ["null", "string"],
      "default": null,
      "doc": "Merchant Category Code (MCC) as a 4-digit string per ISO 18245. High-risk MCCs (e.g. 7995-gambling, 5967-direct marketing) receive elevated base risk scores."
    },
    {
      "name": "merchant_country",
      "type": ["null", "string"],
      "default": null,
      "doc": "ISO 3166-1 alpha-2 country code of the merchant's registered location. Used for cross-border detection and country-risk scoring."
    },
    {
      "name": "channel",
      "type": "string",
      "doc": "Transaction origination channel: 'pos' (point-of-sale), 'ecommerce', 'mobile', 'atm', 'branch', 'api', 'telephone'. Channel-specific risk models are applied during scoring."
    },
    {
      "name": "entry_mode",
      "type": ["null", "string"],
      "default": null,
      "doc": "Card entry mode indicator: 'chip', 'contactless', 'magstripe', 'manual_key', 'token', 'qr_code'. Null for non-card transactions. Magstripe and manual key entries carry higher fraud risk."
    },
    {
      "name": "device_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Unique device identifier (e.g. mobile UDID, terminal ID). Used for device-level velocity tracking and device reputation scoring."
    },
    {
      "name": "device_fingerprint",
      "type": ["null", "string"],
      "default": null,
      "doc": "Browser or device fingerprint hash generated by the client-side SDK. Used for device binding verification and bot detection."
    },
    {
      "name": "ip_address",
      "type": ["null", "string"],
      "default": null,
      "doc": "IPv4 or IPv6 address of the originating request. Used for geo-velocity checks, proxy/VPN detection, and IP reputation scoring."
    },
    {
      "name": "geo_country",
      "type": ["null", "string"],
      "default": null,
      "doc": "ISO 3166-1 alpha-2 country code derived from IP geolocation or GPS coordinates. Used for geo-velocity anomaly detection."
    },
    {
      "name": "geo_latitude",
      "type": ["null", "double"],
      "default": null,
      "doc": "WGS 84 latitude coordinate of the transaction origin. Null when geolocation is unavailable. Used for distance-based velocity calculations."
    },
    {
      "name": "geo_longitude",
      "type": ["null", "double"],
      "default": null,
      "doc": "WGS 84 longitude coordinate of the transaction origin. Null when geolocation is unavailable. Used in conjunction with geo_latitude for geo-fencing rules."
    },
    {
      "name": "geo_city",
      "type": ["null", "string"],
      "default": null,
      "doc": "City name derived from IP geolocation or GPS coordinates. Used for human-readable alert descriptions and investigation context."
    },
    {
      "name": "card_hash",
      "type": ["null", "string"],
      "default": null,
      "doc": "HMAC-SHA256 hash of the full card PAN. Never store or transmit raw PAN. Used for card-level velocity aggregation without PCI DSS scope expansion."
    },
    {
      "name": "card_bin",
      "type": ["null", "string"],
      "default": null,
      "doc": "First 6-8 digits of the card number (Bank Identification Number). Used for issuer identification, BIN-level risk assessment, and card type classification."
    },
    {
      "name": "is_international",
      "type": "boolean",
      "default": false,
      "doc": "Flag indicating whether the transaction is cross-border (merchant country differs from account holder's home country). International transactions typically carry 2-3x higher fraud rates."
    },
    {
      "name": "transaction_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Timestamp when the transaction was initiated at the point of interaction (not ingestion time). Used for time-of-day risk profiling and temporal anomaly detection."
    },
    {
      "name": "metadata",
      "type": {
        "type": "map",
        "values": "string"
      },
      "default": {},
      "doc": "Extensible key-value metadata for channel-specific enrichment fields (e.g. '3ds_version', 'recurring_indicator', 'installment_count'). Consumers SHOULD treat unknown keys as informational only."
    }
  ]
}
